{
    "title": "Chemical Emissions",
    "fields": [
        {
            "id": "chemical",
            "label": "Name",
            "data_type": "string",
            "widget": "select",
            "choices": [],
            "required": true,
            "location": "modal"
        },
        {
            "id": "state",
            "label": "Chemical Type/State",
            "data_type": "string",
            "widget": "select",
            "location": "modal",
            "choices": [
                "Gaseous",
                "Particulate"
            ],
            "required": true,
            "help": "Select the state of the chemical being emitted"
        },
        {
            "id": "have_AERMOD_file",
            "label": "Use Emission values from input file",
            "data_type": "boolean",
            "default": true,
            "help": "Check this box to use Emission values from input file."
        },
        {
            "id": "emissions_source_file",
            "label": "AERMOD Deposition File",
            "data_type": "file",
            "required": true,
            "help": "Indicate the AERMOD output file of emissions data.",
            "if_true": ["have_AERMOD_file"]
        },
        {
            "id": "spacing",
            "label": "spacing",
            "data_type": "string",
            "widget": "select",
            "choices": ["Uniform", "Non-Uniform"],
            "required": true,
            "help": "Enter the spacing of your emission sources.",
            "if_true": ["have_AERMOD_file"]
        }
    ]
}