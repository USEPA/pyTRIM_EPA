            "default": "mg/L"
        },
        {
            "id": "C_surf_water_src",
            "label": "",
            "data_type": "string",
            "readonly": true,
            "default": "manual input",
            "hidden": true
        },
        {
            "id": "FMD",
            "label": "Fraction of Total Chemical Mass That Is Dissolved in Liquid Phase",
            "data_type": "float",
            "min": 0,
            "max": 1,
            "step": "any"
        },
        {
            "id": "FMD_src",
            "label": "",
            "data_type": "string",
            "readonly": true,
            "default": "manual input",
            "hidden": true
        }
    ]
}